{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ALTAIS",
  "version": "0.1.0",
  "identifier": "io.github.tarzanislav.altais",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ALTAIS",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "publisher": "The ALTAIS contributors",
    "copyright": "The ALTAIS contributors, Apache-2.0",
    "category": "Productivity",
    "shortDescription": "Encrypted notes, open source",
    "longDescription": "ALTAIS keeps your notes in an encrypted archive on your computer. Open source, free for private and commercial use.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Slovak", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
